rules_version = '2';

// Regras alinhadas ao uso atual:
// - Foto de perfil: profile_photos/{userId} (ficheiro único por utilizador)
// - Identidade visual (CPC): profile_photos/{userId}/document_branding/{fileName}
service firebase.storage {
  match /b/{bucket}/o {
    match /profile_photos/{userId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Avatar legado ou ficheiros antigos em subpasta (não branding/capas).
    match /profile_photos/{userId}/{fileName} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /profile_photos/{userId}/document_branding/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /profile_photos/{userId}/trail_covers/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /profile_photos/{userId}/trail_module_covers/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /profile_photos/{userId}/trail_module_pdfs/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /company_logos/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Currículo externo do migrante desativado: só leitura/remoção de ficheiros legados.
    match /cv_uploads/migrant/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if false;
    }

    // Currículo externo no perfil desativado: só leitura/remoção de ficheiros legados.
    match /cv_uploads/profile/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if false;
    }

    // Currículo externo desativado (inclui anexos de candidatura pela empresa).
    match /cv_uploads/{contextType}/{contextId}/{fileName} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null;
      allow create, update: if false;
    }
  }
}
