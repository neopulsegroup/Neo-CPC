# CPC — Frontend (Vite) environment variables
# Copie este ficheiro para .env e preencha com os valores apropriados.
# Variáveis VITE_* são embebidas no bundle do cliente — NUNCA colocar
# secrets aqui (use `firebase functions:secrets:set` para secrets do backend).
#
# === Firebase config (opcional — fallback para produção em src/integrations/firebase/client.ts) ===
# Estas variáveis foram extraídas no Bloco 3 (T-31). Em produção podem ficar vazias:
# o código usa os valores de `cpc-projeto-app` como fallback (ver client.ts:7-21).
# Para apontar a um projeto Firebase de staging, descomentar e preencher TODAS abaixo.
# Não são secrets — as Firebase web keys são públicas; o controlo de acesso vive nas rules.
# Ver docs/STAGING.md para o passo a passo de criação do projeto staging.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# === reCAPTCHA v3 — site key pública (T-14) ===
# Obter em: https://console.cloud.google.com/security/recaptcha (projeto cpc-projeto-app)
# Tipo: v3 (score-based). Domínios: portalcpc.com, www.portalcpc.com, localhost, 127.0.0.1
# Lida em src/lib/recaptcha.ts:14
VITE_RECAPTCHA_SITE_KEY=

# === Firebase App Check — site key pública (T-17) ===
# Pode reutilizar a chave do reCAPTCHA OU criar dedicada via Firebase Console > App Check.
# Lida em src/integrations/firebase/client.ts:20
VITE_FIREBASE_APPCHECK_SITE_KEY=

# === Cloud Functions region (opcional) ===
# Lida em src/integrations/firebase/functionsClient.ts:6
# Default no código: us-central1
# VITE_FUNCTIONS_REGION=us-central1

# === Feature flag: usar Cloud Function registerUserSecure ===
# 'true' = callable seguro server-side (recomendado, com rate limit + reCAPTCHA)
# 'false' = fallback client-side (createUserWithEmailAndPassword direto)
# Lida em src/integrations/firebase/auth.ts:185
VITE_USE_SECURE_REGISTER_FUNCTION=true

# === i18n overrides do Firestore (CMS de traduções) ===
# 'true' para puxar overrides em DEV também (default: só em produção)
# Lida em src/contexts/LanguageContext.tsx:191
# VITE_I18N_FIRESTORE_OVERRIDES=

# === Emulators (apenas dev local com `firebase emulators:start`) ===
# Descomentar para apontar o client aos emuladores Firebase
# VITE_USE_EMULATOR=true
# VITE_FUNCTIONS_EMULATOR=true
# VITE_FIRESTORE_EMULATOR_HOST=localhost
# VITE_FIRESTORE_EMULATOR_PORT=8082
# VITE_AUTH_EMULATOR_HOST=localhost
# VITE_AUTH_EMULATOR_PORT=9099
# VITE_FUNCTIONS_EMULATOR_HOST=localhost
# VITE_FUNCTIONS_EMULATOR_PORT=5001
