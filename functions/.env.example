# CPC — Cloud Functions environment variables (NON-SECRET only)
#
# ⚠️  SECRETS NÃO ENTRAM NESTE FICHEIRO ⚠️
#
# Os seguintes são geridos pelo Firebase secret manager:
#   firebase functions:secrets:set RESEND_API_KEY
#   firebase functions:secrets:set RECAPTCHA_SECRET_KEY
#
# Para listar secrets configurados:
#   firebase functions:secrets:access RESEND_API_KEY    # mostra valor (CUIDADO)
#   firebase functions:secrets:get   RESEND_API_KEY    # mostra metadata
#
# Este ficheiro é só para config/flags non-secret usados em dev local.
# Em produção, configurar via deploy environment variables (Cloud Run).

# === reCAPTCHA threshold (score mínimo aceito) ===
# Default no código: 0.5. Subir para 0.7+ em prod se quiser mais rigor.
# Lida em functions/src/registerUserSecure.ts:201
RECAPTCHA_MIN_SCORE=0.5

# === Enforce App Check em callables ===
# 'true' rejeita chamadas sem token App Check válido.
# Recomendado: começar 'false' (modo monitorizar), validar nos logs durante uma
# semana, depois subir para 'true' (enforce). Lida em registerUserSecure.ts:262
ENFORCE_APPCHECK=false

# === Email remetente do RESEND (opcional) ===
# Default fallback no código: 'CPC <geral@portalcpc.com>' (em functions/src/email/sendEmail.ts)
# Em prod: usar domínio verificado no Resend, ex.: contacto@portalcpc.com
# Lida em functions/src/email/sendEmail.ts via process.env.RESEND_FROM_EMAIL
RESEND_FROM_EMAIL=
